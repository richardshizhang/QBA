  "placement": {
    "courses": ["MATH 040", "MATH 108", "CHEM 050"],
    "text": "Entry-level prerequisite. Most QBIO students meet it through a placement exam or AP credit (AP Precalculus 4 or 5 waives MATH 108) instead of taking the course. Check your placement results with your advisor."
  },

  "examCredit": {
    "source": "https://arr.usc.edu/ap-exam-credit-at-usc/",
    "summary": "USC gives 4 units of elective credit for every AP score of 4 or 5, but AP scores don't earn USC course equivalence. Instead, the department that teaches a course can waive it as a prerequisite, and your major advisor can apply it to a degree requirement.",
    "stars": "On STARS, AP credit appears as AP plus the College Board exam number, for example \"AP68:COMP 4.0 TR AP CALCULUS BC\". It counts toward a major requirement only after your advisor adds a substitution, which STARS shows as a note such as \"RE - SUB AP68:COMP FOR MATH125\" (RE = requirement exchange).",
    "noWaiver": "AP Physics and AP Statistics count for elective units and GE, but aren't on USC's list of prerequisite waivers, so they don't replace PHYS courses, QBIO 310 or MATH 307.",
    "exams": [
      {
        "id": "calc-ab", "name": "AP Calculus AB", "short": "AP Calc AB", "stars": "AP66",
        "options": [{ "value": "45", "label": "4 or 5", "waives": ["MATH 125"] }],
        "note": "The AB subscore from the BC exam doesn't count."
      },
      {
        "id": "calc-bc", "name": "AP Calculus BC", "short": "AP Calc BC", "stars": "AP68",
        "options": [
          { "value": "4", "label": "4", "waives": ["MATH 125"] },
          { "value": "5", "label": "5", "waives": ["MATH 125", "MATH 126"] }
        ]
      },
      {
        "id": "cs-a", "name": "AP Computer Science A", "short": "AP CS A", "stars": "AP31",
        "options": [{ "value": "45", "label": "4 or 5", "waives": ["CSCI 102"] }],
        "source": "https://viterbiadmission.usc.edu/wp-content/uploads/2026/06/CS_Curriculum_2026.pdf"
      },
      {
        "id": "csci102-challenge", "name": "CSCI 102 Challenge Exam", "short": "CSCI 102 challenge exam",
        "options": [{ "value": "pass", "label": "Passed", "waives": ["CSCI 102"] }],
        "source": "https://viterbiadmission.usc.edu/wp-content/uploads/2026/06/CS_Curriculum_2026.pdf"
      },
      {
        "id": "chem", "name": "AP Chemistry", "short": "AP Chem", "stars": "AP25",
        "options": [{ "value": "45", "label": "4 or 5", "waives": ["CHEM 105A"] }],
        "note": "You'd start with CHEM 105b. Many medical schools don't accept AP credit in place of college chemistry or biology."
      },
      {
        "id": "bio", "name": "AP Biology", "short": "AP Bio", "stars": "AP20",
